# Скопируй в .env и заполни. Каждое значение — случайная hex-строка: openssl rand -hex 32
POSTGRES_PASSWORD=
KASPI_TOKEN_SECRET_KEY=
KASPI_WEBHOOK_SECRET=
ADMIN_TOKEN=

# Порт, на котором сервер виден автоматам
API_PORT=8080

# Заполнять, только если вход кассира падает с «Обновите приложение» (OldVersionToUpdate):
# версия и номер сборки актуального Kaspi Pay для iOS.
KASPI_APP_VERSION=
KASPI_APP_BUILD=
